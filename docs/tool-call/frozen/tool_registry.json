    {"name": "date_difference", "domain": "arithmetic", "exec": "value"},
    {"name": "round_and_format", "domain": "arithmetic", "exec": "value", "held_out": true, "sibling_of": "convert_units"},
    {"name": "code_interpreter", "domain": "arithmetic", "exec": "bind"},

