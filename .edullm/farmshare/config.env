# Curriculum-new FarmShare profile.
EXPERIMENT_SLUG="curriculum-new"
# No DATASET_ID/DATASET_VERSION or staging config -- the corpus rebuild
# (plan section 4/5) materializes each metric's parent on scratch once,
# under CORPUS_ROOT (see common.sh), ahead of any training job.
TRAIN_GPUS="${TRAIN_GPUS:-4}"
TRAIN_CPUS="${TRAIN_CPUS:-16}"
TRAIN_MEM="${TRAIN_MEM:-128G}"
TRAIN_TIME="${TRAIN_TIME:-20:00:00}"
