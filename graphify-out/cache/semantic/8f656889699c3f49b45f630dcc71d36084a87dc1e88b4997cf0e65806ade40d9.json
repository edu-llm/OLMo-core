{"nodes": [{"id": "config_edullm_policy_document", "label": "eduLLM production policy", "file_type": "document", "source_file": "config/edullm/policy.yaml", "source_location": "L1-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single reviewed control surface for the pilot queue: W&B allowlists, canonical repository, scratch root, Slurm shape, resource caps, required checks, and reminder timers."}, {"id": "config_edullm_policy_required_checks", "label": "Curated required CI checks", "file_type": "concept", "source_file": "config/edullm/policy.yaml", "source_location": "L16-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eleven named checks a requested commit must pass before it is eligible. The list is curated rather than 'every Main job' so credential-dependent and resource-heavy jobs cannot block the queue, while lint, typing, docs, and eduLLM core safety remain mandatory."}, {"id": "config_edullm_policy_resource_limits", "label": "Pilot resource caps", "file_type": "concept", "source_file": "config/edullm/policy.yaml", "source_location": "L13-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At most 2 GPUs, 360 minutes, and a fixed GPU preference allowlist keep any single pilot request bounded on shared MIT Engaging capacity."}, {"id": "config_edullm_policy_allowed_wandb_projects", "label": "Allowed W&B projects and entity", "file_type": "concept", "source_file": "config/edullm/policy.yaml", "source_location": "L1-L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed eduLLM entity plus five project names keeps run telemetry inside reviewed workspaces so results cannot be logged to an unmanaged destination."}, {"id": "config_edullm_policy_slurm_settings", "label": "Slurm partition and resource settings", "file_type": "concept", "source_file": "config/edullm/policy.yaml", "source_location": "L9-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partition mit_normal_gpu, 64G memory, and 4 CPUs per GPU are policy-owned so the generated sbatch shape is reviewed centrally instead of chosen per request."}, {"id": "config_edullm_policy_reminder_timers", "label": "Reminder and reassignment timers", "file_type": "concept", "source_file": "config/edullm/policy.yaml", "source_location": "L28-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 15-minute reminder followed by a 30-minute reassignment bounds how long a request can sit with an unresponsive operator before the rotation moves on."}, {"id": "config_edullm_policy_canonical_repository", "label": "Canonical repository URL", "file_type": "concept", "source_file": "config/edullm/policy.yaml", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naming edu-llm/OLMo-core in policy gives the request path and the operator path the same single source of truth for which remote a commit SHA must exist on."}], "edges": [{"source": "config_edullm_policy_document", "target": "src_edullm_policy_load_policy", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "config/edullm/policy.yaml", "source_location": "L1-L29", "weight": 1.0}, {"source": "config_edullm_policy_document", "target": "src_edullm_jobs_load_gate_configuration", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "config/edullm/policy.yaml", "source_location": "L1-L29", "weight": 1.0}, {"source": "config_edullm_policy_required_checks", "target": "src_edullm_jobs_full_submission_gate", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "config/edullm/policy.yaml", "source_location": "L16-L27", "weight": 1.0}, {"source": "config_edullm