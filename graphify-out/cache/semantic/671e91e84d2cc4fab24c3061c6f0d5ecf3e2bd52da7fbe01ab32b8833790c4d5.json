{"nodes": [{"id": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_design", "label": "eduLLM Jobs Output Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_assigned_visibility_problem", "label": "Invisible Assigned Request Defect", "file_type": "rationale", "rationale": "The jobs service skipped status:assigned Issues because they have no Slurm attempt, so Issue #20 never appeared in edullm jobs --mine even though edullm run correctly selected and submitted it; dense one-line records with long W&B URLs made the remaining output hard to scan.", "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_operator_job_summary_model", "label": "Job Summary Model", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_single_scan_collection", "label": "Single Authoritative Issue Scan", "file_type": "rationale", "rationale": "One queue scan partitions matching Issues; assigned rows short-circuit without touching Slurm while later states take the existing authorization and reconciliation path. The gate reuses the corresponding scan row but still refetches the exact Issue and comments, so the command avoids synthetic lifecycle records and repeated full scans without weakening authorization.", "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_next_action_rendering", "label": "Next-Action Output Rendering", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_fail_closed_output", "label": "Fail-Closed Display Behavior", "file_type": "rationale", "rationale": "A malformed status, assignment, lifecycle comment, Slurm response, or summary invariant fails the whole command rather than displaying untrusted or inconsistent information, because a plausible-looking wrong dashboard is more dangerous than an error.", "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_assigned_visibility_problem", "target": "src_edullm_jobs_operatorjobsummary", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_operatorjobsummary", "target": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_operator_job_summary_model", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_jobs", "target": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_single_scan_collection", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_issue_snapshot", "target": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_single_scan_collection", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_cli_format_operator_jobs", "target": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_next_action_rendering", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_validate_lifecycle", "target": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_fail_closed_output", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_23_edullm_jobs_output_design_next_action_rendering", "target": "src_edullm_jobs_run_assigned", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-jobs-output-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}