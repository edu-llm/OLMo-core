{"nodes": [{"id": "src_scripts_orcd_readme_operator_procedure", "label": "ORCD Smoke Jobs Operator Procedure", "file_type": "document", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_scratch_mount_verification", "label": "Engaging Scratch Mount Verification", "file_type": "rationale", "rationale": "$HOME/orcd/scratch is a separate Engaging Scratch mount and quota despite its Home-shaped path, so the preflight resolves symlinks, requires containment under the Scratch root, compares findmnt targets against the Home mount, and writes a probe file; otherwise a job could silently fill backed-up Home storage.", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_reviewed_sha_supply", "label": "Externally Supplied Reviewed SHA", "file_type": "rationale", "rationale": "The operator or review process must supply the full reviewed 40-character SHA and the procedure never derives trust from whatever commit happens to be checked out remotely; if the commit is not reachable from a remote it must arrive through an approved mechanism such as a verified Git bundle.", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_private_wandb_key", "label": "Private W&B Key Provisioning", "file_type": "rationale", "rationale": "The key is written under umask 077 to ~/.config/edullm/wandb.key, the variable is unset immediately, and jobs source a secret-free wandb.env, because copying the key into sbatch --export or a command argument would expose it in the scheduler and in logs.", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_checkpoint_resume_procedure", "label": "Checkpoint and Resume Procedure", "file_type": "concept", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_forced_offline_exercise", "label": "Forced-Offline W&B Exercise", "file_type": "rationale", "rationale": "The outage drill uses a separate deterministic run identity so it cannot contaminate checkpoint/resume evidence, and it syncs exactly one identified offline-run directory under $SAVE_FOLDER/wandb/wandb rather than --sync-all, which could upload unrelated runs.", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_s3_pilot_conditions", "label": "S3 Pilot Preconditions", "file_type": "concept", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_scripts_orcd_readme_acceptance_evidence_2026_07_22", "label": "Engaging Acceptance Evidence 2026-07-22", "file_type": "document", "source_file": "src/scripts/orcd/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_scripts_orcd_readme_operator_procedure", "target": "src_scripts_orcd_readme_scratch_mount_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/scripts/orcd/README.md", "source_location": null, "weight": 1.0}, {"source": "src_scripts_orcd_readme_operator_procedure", "target": "src_scripts_orcd_readme_reviewed_sha_supply", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/scripts/orcd/README.md", "source_location": null, "weight": 1.0}, {"source": "src_scripts_o