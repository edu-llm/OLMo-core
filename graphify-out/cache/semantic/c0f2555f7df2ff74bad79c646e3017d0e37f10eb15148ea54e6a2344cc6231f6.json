 "source_location": null, "weight": 1.0}, {"source": "src_edullm_cli_build_parser", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_operator_cli", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_assignment_select_operator", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_least_loaded_assignment", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_assignment_process_assignment_timeouts", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_least_loaded_assignment", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_models_jobstatus", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_status_model", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_valid_label_transition", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_status_model", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_lifecyclestate", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_status_model", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_request_parser_parse_issue", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_issue_request_form", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_models_jobrequest", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_issue_request_form", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_models_jobrequest_request_name", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_issue_request_form", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_ssh_control_block", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_ssh_controlmaster_limits", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_jobs_wandb_project", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_wandb_organization", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_slurm_render_sbatch", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_engaging_resource_model", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "weight": 1.