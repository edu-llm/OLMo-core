{"nodes": [{"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_design", "label": "eduLLM ORCD Job Pool Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_credential_isolation_principle", "label": "Credential Isolation Principle", "file_type": "rationale", "rationale": "No MIT, SSH, Kerberos, Duo, W&B, GitHub, or AWS credential is ever shared, and every Engaging job runs under the MIT identity of the operator who submitted it, because an unattended service running through personal accounts would violate ORCD policy and make attribution impossible.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_github_as_queue", "label": "GitHub as Request Queue", "file_type": "rationale", "rationale": "GitHub Issues are the request queue, Slurm remains the compute scheduler, and W&B is the shared live-results interface, so researchers without Engaging access never write Slurm commands and the project builds no custom scheduler or experiment tracker.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_code_review_gate", "label": "Reviewed Commit Definition", "file_type": "rationale", "rationale": "Only an immutable full SHA that is the head of an approved open or merged PR with green required checks may execute. The gate exists because training code runs under an operator's Unix identity and may hold W&B or scoped S3 access, and because a branch name is mutable and therefore unacceptable as an execution identity; any code change produces a new SHA and voids the previous approval.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_operator_cli", "label": "edullm Operator CLI Surface", "file_type": "rationale", "rationale": "Only setup, jobs, jobs --mine, run, logs, stop, and logout are exposed; there is deliberately no claim, run-next, sync, or tail command, so operators cannot rewrite requests and the vocabulary stays plain-language for non-specialists.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_submit_edullm_job_skill", "label": "submit-edullm-job Agent Skill", "file_type": "rationale", "rationale": "The Skill inspects repository/branch/commit/PR, reads the training config and W&B callback, identifies metrics the code actually emits, asks one plain-language question at a time, runs the same validator as CI, and creates the Issue only after confirmation. It may default an engineering smoke to one L40S and 30 minutes but may never choose the hypothesis, comparison, condition, or scientific metric, and never touches credentials.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_metric_instrumentation_handoff", "label": "Metric Instrumentation Handoff", "file_type": "rationale", "rationale": "The /weights-and-biases skill changes instrumentation but does not submit jobs, and /submit-edullm-job creates requests but never invents or implements a metric; a missing metric therefore routes back through instrumentation, commit, and review before a request can be created.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_wandb_organization", "label": "W&B Entity, Project, and Study Model", "file_type": "rationale", "rationale": "Entity eduLLM with five durable project lanes (test, pretraining, posttraining, evaluation, data-pipeline); a group is one stable research study such as skill-dag-v1, never a per-request folder, so multiple Issues and arms stay comparable inside one study. Separate model-architecture or data-corpus projects are avoided for the same reason.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_metric_ownership", "label": "Training Code Owns Metrics", "file_type": "rationale", "rationale": "The training and evaluation code determines which metrics exist and queue automation may not invent one, so the Agent Skill must either find the requested success signal in code or downgrade the request to an engineering-only smoke.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_least_loaded_assignment", "label": "Least-Loaded Assignment and Timeouts", "file_type": "rationale", "rationale": "Assignment scores operators by active requested GPU count, then active job count, then rotation order, with a reminder at 15 minutes and reassignment at 30 minutes, so work spreads across accounts without exceeding the two-GPU per-user Engaging limit and no request stalls on one unavailable operator.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_status_model", "label": "Monotonic Request Status Model", "file_type": "rationale", "rationale": "requested to validating to ready to assigned to submitted to running to a terminal state; transitions are monotonic so terminal states cannot regress and preempted requests need explicit retry approval before returning to ready.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_polling_limitation", "label": "Slurm Polling Limitation", "file_type": "rationale", "rationale": "GitHub cannot continuously poll three personal Slurm accounts without storing personal SSH credentials, so a submitted-but-not-started job stays 'submitted' until W&B reports a start or an operator runs edullm jobs; a future ORCD-approved shared service account would remove this limitation.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_ssh_controlmaster_limits", "label": "SSH ControlMaster Convenience and Limits", "file_type": "rationale", "rationale": "MIT documents ControlMaster as the supported way to reuse one Kerberos/Duo login, so the first connection authenticates normally and later commands multiplex over a local control socket with ControlPersist 1h. The private key never leaves the operator's computer; this is explicitly not an unattended service credential and does not let GitHub Actions reach Engaging.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_engaging_resource_model", "label": "Engaging Resource Model", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_issue_request_form", "label": "Structured Issue Request Form", "file_type": "rationale", "rationale": "One shared form with fifteen required fields and no separate 'custom job' category; the requester identity is derived from the Issue author and arguments are structured values rather than a shell string, so students never supply a repository URL, environment path, credential, sbatch command, or shell pipeline, and restricted data is rejected outright.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_s3_pilot", "label": "S3 Staging Pilot", "file_type": "rationale", "rationale": "Data is staged once from S3 to Engaging Scratch/Pool, verified by size and SHA-256 immediately before training, and only selected outputs are copied back. Unversioned sandbox buckets are never called production, interactive credentials never land on Engaging, and no GPU worker repeatedly streams the same corpus from S3.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_staged_verification", "label": "Six-Stage Verification Ladder", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_acceptance_criteria", "label": "Initial Vertical Slice Acceptance", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_failure_handling", "label": "Failure Handling Policy", "file_type": "rationale", "rationale": "Validation failure leaves the Issue open with actionable corrections and no assignment, Slurm queueing is not a failure, a W&B outage never fails training because local files sync later, GPU OOM fails without automatic resource escalation, and preemption preserves the checkpoint and needs explicit approval to return to ready.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_hypothesis_branch_gaps", "label": "Hypothesis Branch Readiness Gaps", "file_type": "rationale", "rationale": "The hypothesis/smoke-skilldag-cl branch is preparation-ready but not end-to-end ready: run_smoke.sh exits after a successful dry_run, the Skill-DAG mix JSON is printed but never reaches the loader, the curriculum order is never materialized, the 190M/370M scripts default to AI2 GCS paths, and W&B callbacks are disabled and point at different projects.", "source_file": "docs/superpowers/specs/2026-07-22-orcd-job-pool-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_design", "target": "docs_supe