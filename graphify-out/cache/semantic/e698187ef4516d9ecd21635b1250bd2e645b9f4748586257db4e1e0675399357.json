{"nodes": [{"id": "config_edullm_entrypoints_generic_smoke", "label": "generic-smoke entrypoint profile", "file_type": "concept", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L2-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A one-GPU olmo2-190m torchrun smoke with a 20-step hard stop, evaluators disabled, and a single slug positional; it exists to prove the ORCD path end to end cheaply, not to produce science."}, {"id": "config_edullm_entrypoints_hypothesis_smoke", "label": "hypothesis-smoke entrypoint profile", "file_type": "concept", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L37-L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows skill-dag and curriculum data with three ordered positionals and a required bounded seed option, capping trainer.hard_stop at 100 steps so a hypothesis probe cannot silently become a long run."}, {"id": "config_edullm_entrypoints_worked_examples_cpt", "label": "worked-examples-cpt entrypoint profile", "file_type": "concept", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L52-L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A locked two-GPU h100 continued-pretraining arm on olmo2-760m with a pinned pack directory, checkpoint load path, token budget, and seed; the only researcher-selectable knob is the arm choice bound to the request's condition field."}, {"id": "config_edullm_entrypoints_fixed_options", "label": "Policy-owned fixed options", "file_type": "rationale", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L9-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch sizes, sequence length, checkpoint intervals, and W&B entity/project/tags are fixed by the platform rather than supplied per request, so a request cannot redirect telemetry or exceed the profile's resource shape."}, {"id": "config_edullm_entrypoints_derived_path", "label": "derived_path option type", "file_type": "concept", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L12-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save-folder and work-dir are computed from the EDULLM_SCRATCH root plus runs/{run_name} instead of accepting a request-supplied path, which keeps every run inside operator-owned scratch and out of arbitrary filesystem locations."}, {"id": "config_edullm_entrypoints_request_field_binding", "label": "request_field option binding", "file_type": "concept", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L31-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declaring {type: request_field, field: study|condition|seed} ties a launched option to the validated request record, so the W&B group, the CPT arm, and the seed cannot diverge from what the Issue actually asked for."}, {"id": "config_edullm_entrypoints_allowed_positionals", "label": "Allowed positional argument contract", "file_type": "concept", "source_file": "config/edullm/entrypoints.yaml", "source_location": "L33-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each profile declares an exact positional count and per-index allowlist (slug, or literal sets like dry_run/train_single/train and local), turning argv into a validated ordered prefix rather than free-form text."}], "edges": [{"source": "config_edullm_entrypoints_generic_smoke", "target": "config_edullm_entrypoints_fixed_options", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "config/edullm/entrypoints.yaml", "source_location": "L9-L32", "weight": 1.0}, {"source": "config_edullm_entrypoints_worked_examples_cpt", "target": "config_edullm_entrypoints_fixed_options", "relation": "impleme