{"nodes": [{"id": "docs_source_guides_edullm_engaging_engaging_guide", "label": "Engaging With eduLLM Guide", "file_type": "document", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_pilot_status", "label": "Operational Pilot Status", "file_type": "concept", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_operator_onboarding", "label": "Operator Onboarding Procedure", "file_type": "concept", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_reviewed_roster", "label": "Centrally Reviewed Operator Roster", "file_type": "rationale", "rationale": "Operator Slack member IDs live in the reviewed roster and edullm setup never asks for a Slack ID. Assignment eligibility is independent of setup success, so an enabled operator must still finish local and ORCD setup before accepting jobs.", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_operator_command_surface", "label": "Operator Command Surface", "file_type": "concept", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_assignment_workflow", "label": "Credential-Free Assignment Workflow", "file_type": "rationale", "rationale": "GitHub Actions validate the Issue and assign exactly one enabled operator with one Slack notification while holding only GitHub's scoped token and the assignment webhook; ORCD, SSH, Kerberos, Duo, W&B, and S3 credentials stay operator-side.", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_identity_and_safety", "label": "Identity and Submission Safety Guarantees", "file_type": "rationale", "rationale": "There are no shared credentials, requests cannot use a direct-main SHA or supply shell text, the exact pushed SHA is checked during validation and again immediately before submission, structured arguments are shell-quoted, and the idempotent submission transaction permits exactly one sbatch.", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_deterministic_wandb_identity", "label": "Deterministic W&B Run Identity", "file_type": "rationale", "rationale": "Each attempt derives its W&B run ID and URL from the Issue, attempt number, and Slurm job ID so the URL can be predicted and posted without querying W&B, and so no two attempts share an identity.", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_scheduler_state_reconciliation", "label": "Scheduler State Reconciliation", "file_type": "concept", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_source_guides_edullm_engaging_deferred_scope", "label": "Deferred Initial-Slice Scope", "file_type": "rationale", "rationale": "The initial slice deliberately excludes scheduled W&B monitoring, Plan 3 work, S3, Apptainer, advanced Slack reminders or terminal threads, strict ruleset automation, and broad rollout polish so the core request-to-results path can be accepted on its own.", "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_source_guides_edullm_engaging_engaging_guide", "target": "docs_source_guides_edullm_engaging_operator_command_surface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "weight": 1.0}, {"source": "docs_source_guides_edullm_engaging_operator_command_surface", "target": "src_edullm_cli_build_parser", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "weight": 1.0}, {"source": "docs_source_guides_edullm_engaging_operator_command_surface", "target": "src_edullm_cli_handle_run", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "weight": 1.0}, {"source": "docs_source_guides_edullm_engaging_operator_command_surface", "target": "src_edullm_cli_handle_logs", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "weight": 1.0}, {"source": "docs_source_guides_edullm_engaging_operator_command_surface", "target": "src_edullm_cli_handle_stop", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/source/guides/edullm_engaging.rst", "source_location": null, "weight": 1.0}, {"source": "docs_source_guides_edullm_engaging_operator_onboarding", "target": "src_edullm_cli_setup_operator", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/source/guides/edullm_engaging.rst", "source