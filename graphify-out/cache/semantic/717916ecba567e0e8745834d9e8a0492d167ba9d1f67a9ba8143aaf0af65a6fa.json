{"nodes": [{"id": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_design", "label": "eduLLM SSH Session Reliability Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_expired_controlmaster_failure", "label": "Expired ControlMaster Timeout Failure", "file_type": "rationale", "rationale": "With the one-hour ControlMaster expired, SSH began an interactive password and Duo login inside the 30-second command timeout, so authentication consumed the budget, the Slurm query was cancelled, and the CLI reduced everything to 'edullm jobs failed'. A traced run failed after 32.7 seconds; running ssh -MNf orcd-login manually made the same command succeed.", "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_session_lifecycle", "label": "SSH Session Lifecycle", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_authentication_budget", "label": "Split Authentication and Command Budgets", "file_type": "rationale", "rationale": "Human password and Duo interaction gets up to five minutes while ordinary remote operations stay bounded at 30 seconds, which removes the need for a longer ControlPersist interval because automatic reconnection now handles expiry.", "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_fixed_recovery_message", "label": "Fixed Actionable Session Error Message", "file_type": "rationale", "rationale": "Session bootstrap failures produce exactly one message, 'ORCD SSH login failed; run ssh -MNf orcd-login and retry.', so operators get a concrete recovery step while raw subprocess output, private paths, and credentials remain suppressed.", "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_expired_controlmaster_failure", "target": "src_edullm_ssh_sshclient_ensure_master", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_ssh_sshclient_ensure_master", "target": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_session_lifecycle", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "weight": 1.0}, {"source": "src_edullm_ssh_sshsessionerror", "target": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_fixed_recovery_message", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-23-edullm-ssh-session-reliability-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_23_edullm_ssh_session_reliability_design_authentication_budget", "target": "src_e