{"nodes": [{"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_plan", "label": "eduLLM GitHub Queue and Operator Pool Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_global_constraints", "label": "Job Pool Global Constraints", "file_type": "rationale", "rationale": "No SSH/Kerberos/Duo credentials anywhere in GitHub, W&B, Slack, configuration, or fixtures; execute only a full SHA from a green approved PR or merged main; never execute a shell string from an Issue but render argv from typed fields without eval; cap at one or two GPUs and six hours; pin third-party Actions by full SHA; operators submit through their own Engaging accounts.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_package_boundary", "label": "edullm Package Boundary", "file_type": "rationale", "rationale": "src/edullm/ is a separate project-specific namespace from src/olmo_core/; it may use requests and PyYAML but not OLMo training internals, and queue logic never enters olmo_core so training semantics stay untouched by the queue.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_entrypoint_profile", "label": "Protected Entrypoint Profile", "file_type": "rationale", "rationale": "The Issue form selects a profile name and the script, launcher, positional schema, and option schema are derived from the protected entrypoints.yaml and must match exactly, so running a new arbitrary program requires a reviewed change to that file rather than an Issue edit.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_canonical_request_digest", "label": "Canonical Request JSON and Digest", "file_type": "rationale", "rationale": "Validated requests are serialized as canonical JSON with a SHA-256 digest and validation timestamp into the bot's edullm-status:v1 comment. Editing the Issue removes status:ready and a new digest is issued only after revalidation, making post-approval tampering detectable before submission.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_issue_form_parsing", "label": "Deterministic Issue-Form Parsing", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_reviewed_commit_gate", "label": "Reviewed-Commit Execution Gate", "file_type": "rationale", "rationale": "A SHA runs only when it is the head of an open or merged PR, an allowed reviewer approved that exact commit_id, no current review requests changes, every required check succeeded, and the selected script exists at that SHA; approvals for a previous SHA and later CHANGES_REQUESTED reviews both revoke eligibility.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_validation_workflow", "label": "Least-Privilege Validation Workflow", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_least_loaded_assignment", "label": "Least-Loaded Operator Selection", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_assignment_concurrency_group", "label": "Serialized Assignment Concurrency Group", "file_type": "rationale", "rationale": "Assignment runs in one repository-wide concurrency group with cancel-in-progress false and refetches every active Issue immediately before computing capacity, so two simultaneous queue events cannot both hand the last GPU slot to the same operator.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_fail_closed_operators", "label": "Fail-Closed Operator Roster", "file_type": "rationale", "rationale": "config/edullm/operators.yaml is committed as an empty list and the example file holds fixture identities only, so assignment refuses to run until a reviewed operator entry is added rather than defaulting to an unvetted account.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_notifications", "label": "Sanitized Slack Assignment Notification", "file_type": "rationale", "rationale": "Slack payloads strip angle brackets and truncate the title to 120 characters so an Issue title cannot inject Slack markup or mentions, and the webhook is exposed only to the steps that send notifications.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_ssh_controlmaster_setup", "label": "Operator SSH ControlMaster Setup", "file_type": "rationale", "rationale": "setup parses the existing ~/.ssh/config, shows the exact addition, backs it up, and asks for confirmation before writing with mode 0600. Remote content travels through write_remote() stdin rather than argv so secrets never appear in a process listing.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_setup_preflight", "label": "edullm setup Preflight Sequence", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_cli_command_surface", "label": "argparse Command Surface", "file_type": "rationale", "rationale": "The parser exposes only plain-language subcommands (setup, jobs, run, logs, stop, logout, automation) and a test asserts that jargon such as 'claim' and 'sync' never appears in help; each subcommand dispatches to a focused function so SSH and GitHub logic stay out of main().", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_sbatch_rendering", "label": "Structured sbatch Rendering", "file_type": "rationale", "rationale": "render_sbatch builds argv from typed fields and shlex-quotes every part, uses --export=NONE, clones a fresh worktree, checks out the exact detached SHA, asserts a clean tree and that olmo_core resolves inside PYTHONPATH, and never emits eval or WANDB_API_KEY, so an Issue cannot smuggle shell text into a compute node.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_data_manifest_verification", "label": "Data Manifest Verification", "file_type": "rationale", "rationale": "Manifests must resolve under approved roots, match the declared SHA-256, bind every referenced shard by size and digest, and declare a kind allowed by the entrypoint. Verification runs over SSH immediately before sbatch and again inside the Slurm script, and direct s3:// training manifests are rejected until data is staged into /orcd/pool/.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_submission_preflight", "label": "edullm run Submission Preflight", "file_type": "rationale", "rationale": "run reads assigned Issues, selects the oldest validated request, requires the live Issue digest to equal the validated digest, revalidates SHA/review/manifest/policy, refetches the status comment immediately before submission to confirm digest and timestamp are unchanged, then renders, submits, appends an AttemptRecord, and posts the Slurm ID and deterministic W&B URL.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_wandb_status_reconciliation", "label": "Monotonic W&B Status Reconciliation", "file_type": "rationale", "rationale": "issue_status maps W&B states to Issue states through an allowed-transition table so terminal states never regress and an unrequested kill is a failure. A preempted Issue stays preempted until retry-approved, and the retry always creates a new AttemptRecord rather than reusing the previous Slurm/W&B identity.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_codeowners_protection", "label": "CODEOWNERS Queue Protection", "file_type": "rationale", "rationale": "config/edullm/, CODEOWNERS, edullm workflows, src/edullm/, and the submission Skill are owned by @edu-llm/compute-operators. If the team cannot be created the task stops and queue workflows stay disabled rather than substituting an unprotected path for the review gate.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_main_ruleset", "label": "main Branch Protection Ruleset", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_agent_skill", "label": "submit-edullm-job Agent Skill and Shared Validator", "file_type": "rationale", "rationale": "The Skill writes the previewed request to a mode-0600 temporary JSON file, runs the shared validate_request wrapper, displays errors, and deletes the file, so the Skill and the GitHub workflow reach identical verdicts through the same JobRequest and validate_request() code path.", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_pilot_acceptance", "label": "Queue Pilot Acceptance Criteria", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_plan", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_plan", "target": "docs_source_guides_edullm_engaging_engaging_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-edullm-job-pool-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_edullm_job_pool_implementation_plan", "target": "src_edullm_models_jobrequest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-edullm-