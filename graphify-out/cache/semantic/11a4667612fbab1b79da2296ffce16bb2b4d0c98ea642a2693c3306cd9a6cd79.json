{"nodes": [{"id": "claude_skills_submit_edullm_job_skill_submit_edullm_job", "label": "submit-edullm-job Skill", "file_type": "document", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L1-L171", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly invoked workflow (disable-model-invocation: true) that produces exactly one validated request Issue and never submits compute; the Issue is a request artifact, not a submission."}, {"id": "claude_skills_submit_edullm_job_skill_exact_sha_gate", "label": "Exact pushed-SHA identity gate", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L25-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A request must name a 40-character lowercase SHA that exists on the canonical edu-llm/OLMo-core remote, on a clean non-main branch, so the reviewed code and the executed code are provably identical. Short SHAs and PR links are rejected because they are not stable commit evidence."}, {"id": "claude_skills_submit_edullm_job_skill_fail_closed_precondition", "label": "Fail-closed precondition handling", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L27-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A command error counts as a failed gate rather than evidence of success, and raw diagnostics are suppressed so error text cannot leak repository or credential detail. The agent may not repair the precondition itself (no push, commit, branch switch, or tree clean)."}, {"id": "claude_skills_submit_edullm_job_skill_credential_prohibition", "label": "Credential handling prohibition", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L16-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Skill never reads, prints, or requests tokens or environment material, and may only use the user's already-configured git and gh clients; compute, SSH, ORCD, Slurm, and W&B APIs are entirely out of scope."}, {"id": "claude_skills_submit_edullm_job_skill_observable_metrics_check", "label": "Observable metric verification", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L64-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Success metrics are traced statically through the selected script's W&B callback instead of by calling W&B, so a request can never promise a metric the committed code does not emit. Missing wiring must be committed, pushed, and re-gated before the request restarts."}, {"id": "claude_skills_submit_edullm_job_skill_team_intent_collection", "label": "One-field-at-a-time intent collection", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L74-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scientific intent (hypothesis, condition, comparison, seed, data mixture, metrics) belongs to the submitting team, so the agent asks for one missing field at a time and never invents, selects, or alters a value."}, {"id": "claude_skills_submit_edullm_job_skill_validation_adapter", "label": "Authoritative validation adapter", "file_type": "concept", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L110-L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Skill executes the repository's validate_request.py adapter rather than reimplementing parsing, policy, or validation, so there is exactly one request schema and prompt drift cannot weaken it."}, {"id": "claude_skills_submit_edullm_job_skill_private_preview", "label": "Private validation and preview", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L91-L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Request material is written to a 0700 mktemp directory with 0600 files and a cleanup trap, never into command arguments or logs, so the Issue body and arguments cannot leak through shell history or tracing. Any field change forces re-validation to prevent a stale preview being confirmed."}, {"id": "claude_skills_submit_edullm_job_skill_request_issue", "label": "Confirmed eduLLM request Issue", "file_type": "concept", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L133-L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created only after explicit human confirmation, titled [eduLLM job]: {STUDY}-{CONDITION}, labelled edullm-job and status:requested, and built from the exact validated issue.md that must not be edited or re-rendered after validation."}, {"id": "claude_skills_submit_edullm_job_skill_actions_authority", "label": "Actions-authoritative state reporting", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L157-L170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only GitHub Actions may declare requested, validation errors, ready, or an assignee; local validation, initial labels, elapsed time, and inference are never acceptable evidence of acceptance or assignment."}, {"id": "claude_skills_submit_edullm_job_skill_execution_boundary", "label": "Skill versus operator execution boundary", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L9-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requesting and authorizing are separated: the Skill's authority ends at the request Issue, PR review controls merging to main, and only the assigned operator authorizes a job by running edullm run."}], "edges": [{"source": "claude_skills_submit_edullm_job_skill_submit_edullm_job", "target": "claude_skills_submit_edullm_job_request_reference_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L21", "weight": 1.0}, {"source": "claude_skills_submit_edullm_job_skill_validation_adapter", "target": "claude_skills_submit_edullm_job_scripts_validate_request", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L115", "weight": 1.0}, {"source": "claude_skills_submit_edullm_job_skill_validation_adapter", "target": "claude_skills_submit_edullm_job_scripts_validate_request_validate_submission", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L110-L119", "weight": 1.0}, {"source": "claude_skills_submit_edullm_job_skill_validation_adapter", "target": "src_edullm_validation_validate_request", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L22-L23", "weight": 1.0}, {"source": "claude_skills_submit_edullm_job_skill_submit_edullm_job", "target": "github_issue_template_edullm_job_request_issue_form", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/submit-edullm-job/SKILL.md", "source_location": "L12", "weight": 1.0}, {"source": "claude_skills_submit_edullm_job_skill_request_issue", "target": "github_issue_template_edullm_job_request_initial_labels", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/submit-ed