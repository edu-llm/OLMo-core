{"nodes": [{"id": "claude_skills_submit_edullm_job_request_reference_document", "label": "eduLLM request reference", "file_type": "document", "source_file": ".claude/skills/submit-edullm-job/request-reference.md", "source_location": "L1-L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "claude_skills_submit_edullm_job_request_reference_single_schema_rule", "label": "Single authoritative request schema", "file_type": "rationale", "source_file": ".claude/skills/submit-edullm-job/request-reference.md", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "request_parser.py, policy.py, and validation.py are the sole request schema; the reference deliberately explains only how to collect values so a second, drifting request model is never created in prose."}, {"id": "claude_skills_submit_edullm_job_request_reference_issue_headings_order", "label": "ISSUE_HEADINGS field order", "file_type": "concept", "source_file": ".claude/skills/submit-edullm-job/request-reference.md", "source_location": "L7-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nineteen string fields in a fixed order (Purpose through Maximum runtime minutes) so the JSON object, the rendered Issue body, and the parser's headings stay byte-identical and round-trippable."}, {"id": "claude_skills_submit_edullm_job_request_reference_data_manifest_contract", "label": "Data manifest and digest contract", "file_type": "concept", "source_file": ".claude/skills/submit-edullm-job/request-reference.md", "source_location": "L22-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only builtin://generic-smoke-v1 or a policy-controlled /orcd/pool manifest is accepted, always paired with the exact lowercase SHA-256 digest; S3 URIs are excluded because the pilot queue cannot verify them."}, {"id": "claude_s