{"nodes": [{"id": "github_workflows_main_workflow", "label": "Main CI workflow", "file_type": "document", "source_file": ".github/workflows/main.yml", "source_location": "L1-L347", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "github_workflows_main_check_matrix", "label": "CPU check matrix", "file_type": "concept", "source_file": ".github/workflows/main.yml", "source_location": "L28-L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named matrix tasks (Lint, Test, Test checkpoint, Test transformer, Test attention, Test examples, Test scripts, Test eduLLM core, Integration tests, Type check, Build, Style, Docs) each surface as an individually addressable check name, which is what lets the eduLLM policy require a curated subset by name."}, {"id": "github_workflows_main_test_edullm_core_check", "label": "Test eduLLM core check", "file_type": "concept", "source_file": ".github/workflows/main.yml", "source_location": "L86-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/test/edullm and src/test/scripts/orcd are excluded from the broad Test task and run as one dedicated check, so eduLLM queue safety has a single unambiguous required status rather than being hidden inside a large mixed job."}, {"id": "github_workflows_main_gpu_checks", "label": "GPU checks via Beaker Gantry", "file_type": "concept", "source_file": ".github/workflows/main.yml", "source_location": "L168-L289", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPU jobs shell out to Gantry against a Beaker workspace and are skipped when BEAKER_TOKEN is absent, so they depend on external credentials the eduLLM gate deliberately does not require."}, {"id": "github_workflows_main_release_job", "label": "Tag-triggered release job", "file_type": "concept", "source_file": ".github/workflows/main.yml", "source_location": "L291-L347", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Release runs only for refs/tags and only after checks succeed, publishing to PyPI and GitHub Releases from the artifact built by the Build check."}, {"id": "github_workflows_main_dependency_cache_key", "label": "CACHE_PREFIX dependency cache key", "file_type": "concept", "source_file": ".github/workflows/main.yml", "source_location": "L17-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache keys hash pyproject.toml alongside a manually bumped CACHE_PREFIX, so a dependency change both invalidates the cached environment and provides the escape hatch when a stale environment must be discarded."}], "edges": [{"source": "github_workflows_main_workflow", "target": "github_workflows_main_check_matrix", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/main.yml", "source_location": "L28-L120", "weight": 1.0}, {"source": "github_workflows_main_check_matrix", "target": "github_workflows_main_test_edullm_core_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/main.yml", "source_location": "L86-L90", "weight": 1.0}, {"source": "github_workflows_main_check_matrix", "target": "config_edullm_policy_required_checks", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/main.yml", "source_location": "L40-L120", "weight": 1.0}, {"source": "github_workflows_main_test_edullm_core_check", "target": "config_edullm_policy_required_checks", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/main.yml", "source_location": "L86", "weight": 1.0}, {"source": "src_test_edullm_task_4_config_test_test_main_ci_has_one_required_edullm_core_check", "target": "github_workflows_main_test