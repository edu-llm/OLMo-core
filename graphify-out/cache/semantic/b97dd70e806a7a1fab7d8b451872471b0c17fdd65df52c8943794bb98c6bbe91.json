{"nodes": [{"id": "docs_edullm_ci_stability_design_document", "label": "eduLLM CI Stability Design", "file_type": "document", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L1-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_edullm_ci_stability_design_dependency_drift", "label": "Dependency drift incident", "file_type": "rationale", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L3-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On July 23, 2026 the Lint check went from green under Ruff 0.15.22 to 3,830 findings under Ruff 0.16.0 for a five-line documentation PR, because CI installs an unbounded ruff dev dependency. The failure is evidence of environment nondeterminism, not of a broken eduLLM training path."}, {"id": "docs_edullm_ci_stability_design_ruff_pin", "label": "Ruff 0.15.22 pin", "file_type": "rationale", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L33-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinning ruff in pyproject.toml to the exact last-known-good release restores determinism with a one-line change, covers both Lint and Lint (min Python) through the existing all extra, and incidentally rotates the dependency cache key so the old unbounded environment cannot be reused."}, {"id": "docs_edullm_ci_stability_design_curated_gate_preservation", "label": "Curated gate preservation", "file_type": "rationale", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L41-L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config/edullm/policy.yaml is deliberately left unchanged: the repair fixes the environment rather than lowering the bar, so all eleven required checks continue to gate eligibility."}, {"id": "docs_edullm_ci_stability_design_credential_dependent_exclusion", "label": "Credential-dependent job exclusion", "file_type": "rationale", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L14-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jobs needing S3, Beaker, gated Hugging Face models, or GPUs stay visible in Main but outside the eligibility decision, because adding AWS/Beaker/HF/ORCD/W&B credentials to Actions is an explicit non-goal."}, {"id": "docs_edullm_ci_stability_design_rejected_alternatives", "label": "Rejected alternatives", "file_type": "rationale", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L77-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dropping Lint from the gate would hide a real reproducibility defect; fixing all 3,830 Ruff 0.16.0 findings now is an unrelated repository-wide migration; requiring every Main job would couple eduLLM to external credentials. Ruff 0.16.0 is deferred to a separate reviewed migration."}, {"id": "docs_edullm_ci_stability_design_verification_criteria", "label": "Repair verification criteria", "file_type": "concept", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L58-L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptance requires the 994-test edullm baseline still passing, Ruff 0.15.22 reported by the installed environment and by both Lint jobs, and all eleven curated checks green on the exact requested training commit."}, {"id": "docs_edullm_ci_stability_design_rollout", "label": "Rollout sequence", "file_type": "concept", "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L68-L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging the pin produces a new experiment head SHA, which must be re-approved by a different listed approver before a fresh /submit-edullm-job request is made, preserving exact-SHA approval end to end."}], "edges": [{"source": "docs_edullm_ci_stability_design_document", "target": "docs_edullm_ci_stability_design_ruff_pin", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L33-L39", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_dependency_drift", "target": "docs_edullm_ci_stability_design_ruff_pin", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L3-L39", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_dependency_drift", "target": "github_workflows_main_check_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L5-L8", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_ruff_pin", "target": "github_workflows_main_dependency_cache_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L37-L39", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_curated_gate_preservation", "target": "config_edullm_policy_required_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L41-L53", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_credential_dependent_exclusion", "target": "github_workflows_main_gpu_checks", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L14-L29", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_rejected_alternatives", "target": "docs_edullm_ci_stability_design_curated_gate_preservation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L77-L83", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_rollout", "target": "claude_skills_submit_edullm_job_skill_submit_edullm_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L73", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_rollout", "target": "claude_skills_submit_edullm_job_skill_exact_sha_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L70-L75", "weight": 1.0}, {"source": "docs_edullm_ci_stability_design_verification_criteria", "target": "github_workflows_main_test_edullm_core_check", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/edullm-ci-stability-design.md", "source_location": "L62", "weight": 1.0}], "hyperedges": [{"id": "edullm_ci_lint_stability_repair", "label": "eduLLM CI lint stability repair", "nodes": ["docs_edullm_ci_stability_design_dependency_drift", "docs_edullm_ci_stability_design_ruff_pin", "docs_edullm_ci_stability_implementation_plan_dependency_contract_test", "github_workflows_main_check_matrix", "config_edullm_policy_required_checks"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/edullm-ci-stability-design.md"}]}