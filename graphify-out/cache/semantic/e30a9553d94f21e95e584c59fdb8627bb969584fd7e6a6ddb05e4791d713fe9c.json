{"nodes": [{"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_plan", "label": "ORCD Bootstrap and W&B Smoke Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_storage_tiering", "label": "Engaging Storage Tiering", "file_type": "rationale", "rationale": "Persistent code and the Python environment live in Engaging Home, active data and outputs in Scratch, and credentials in operator-private mode-0600 files, because Home is backed up but small while Scratch is the fast working tier for job data.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_no_login_node_installs", "label": "No Login-Node Installs", "file_type": "rationale", "rationale": "Environment setup is submitted to the mit_normal partition as a Slurm job instead of running on a login node, so package builds do not consume shared login resources.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_environment_probe", "label": "GPU and Environment Probe", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_deterministic_tiny_data", "label": "Deterministic Tiny Token Data", "file_type": "rationale", "rationale": "A seeded numpy generator writes GPT-2-compatible uint16 memmaps plus a manifest so two operators produce byte-identical smoke data and the smoke never depends on downloading a corpus.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_generic_smoke", "label": "Generic 20-Step OLMo2-190M Smoke", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_offline_wandb_fallback", "label": "Offline W&B Fallback", "file_type": "rationale", "rationale": "The runner probes api.wandb.ai and exports WANDB_MODE=offline when it is unreachable, keeping run files under SAVE_FOLDER/wandb for a later wandb sync, because a tracking outage must never fail an otherwise healthy training job.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_checkpoint_resume_identity", "label": "Stable Checkpoint and Resume Identity", "file_type": "rationale", "rationale": "RUN_NAME, WANDB_RUN_ID, SAVE_FOLDER, and WANDB_RESUME=allow are held constant across the initial and resumed submissions so the second job loads the saved checkpoint and continues the same W&B run instead of starting a new identity.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_commit_pinning_preflight", "label": "Commit-Pinning Job Preflight", "file_type": "rationale", "rationale": "Every sbatch script asserts that git rev-parse HEAD equals the exported EDULLM_COMMIT_SHA, that the checkout is clean, and that the imported olmo_core resolves under the reviewed PYTHONPATH, so a job can never silently execute drifted or foreign code.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_s3_transfer_pilot", "label": "Bounded S3 Transfer Pilot", "file_type": "rationale", "rationale": "Presigned GET/PUT URLs live only in a temporary mode-0600 JSON file outside the repository, transfer errors are reduced to exception type names so signatures never leak, downloads are size-bounded and digest-checked, and throughput and cost are measured before any scaling decision.", "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_environment_probe", "target": "src_scripts_orcd_probe_build_report", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_environment_probe", "target": "src_scripts_orcd_probe_check_cuda", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-orcd-bootstrap-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_orcd_bootstrap_implementation_environment_probe",