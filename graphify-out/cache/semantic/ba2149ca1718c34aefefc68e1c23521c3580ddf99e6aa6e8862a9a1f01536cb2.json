{"nodes": [{"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_plan", "label": "Skill-DAG and Curriculum Smoke Wiring Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_core_olmo_unchanged", "label": "Core OLMo Untouched Constraint", "file_type": "rationale", "rationale": "src/olmo_core/** and the generic OLMo2-190M/370M templates stay unmodified; the hypothesis work adds one shared data module, one curriculum materializer, and one smoke entrypoint so experiment wiring never changes shared training semantics.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_skill_dag_mix_wiring", "label": "Skill-DAG Mix Weight Wiring", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_curriculum_materialization", "label": "Curriculum Order Materialization", "file_type": "rationale", "rationale": "The order JSONL is materialized into one contiguous uint32 shard containing every document exactly once, and the loader runs with shuffle=False, because a curriculum condition is meaningless unless the requested document order survives into the training stream.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_hypothesis_smoke_entrypoint", "label": "OLMo2-190M Hypothesis Smoke Entrypoint", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_condition_identity", "label": "Condition Identity Provenance", "file_type": "rationale", "rationale": "hypothesis_identity.json records mode, substrate version, domain-index and artifact SHA-256, seed, and pinned dataset/tokenizer revisions, and the mix or order artifact is copied into save_folder/provenance/ before training, so the exact data condition behind a run can be reconstructed later.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_dry_run_then_train", "label": "Dry-Run Then Train Contract", "file_type": "rationale", "rationale": "The wrapper always performs the dry-run and then trains only when SMOKE_RUN_MODE=train, rejecting every other value and forbidding ||, because the earlier wrappers exited after a successful dry_run and silently never trained.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_queue_consumable_manifest", "label": "Queue-Consumable Data Manifest", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_fail_fast_preparation", "label": "Fail-Fast Data Preparation", "file_type": "rationale", "rationale": "The raw-only success path is removed and preparation exits nonzero on tokenizer failure, zero-document domains, null token paths, empty shards, out-of-vocabulary IDs, or unpinned dataset/tokenizer revisions, so a silently degraded corpus can never reach a GPU run.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_apptainer_image_pinning", "label": "Digest-Pinned Apptainer Image", "file_type": "rationale", "rationale": "The base image is resolved to an immutable repository@sha256 digest, the child image records the source revision label, and the pulled SIF's SHA-256 is recorded in operator configuration; mutable tags, missing revision labels, wrong SIF digests, and non-linux/amd64 images are rejected so all operators execute byte-identical environments.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_smoke_scope_disclaimer", "label": "Smoke Validates Plumbing Not Hypothesis", "file_type": "rationale", "rationale": "A smoke verifies data wiring and execution, not the hypothesis effect, so acceptance evidence must be labelled smoke validation and never presented as scientific support for Skill-DAG or curriculum claims.", "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_skill_dag_mix_wiring", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_hypothesis_branch_gaps", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_dry_run_then_train", "target": "docs_superpowers_specs_2026_07_22_orcd_job_pool_design_hypothesis_branch_gaps", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_plan", "target": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_curriculum_materialization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_plan", "target": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_skill_dag_mix_wiring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-22-hypothesis-smoke-wiring-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_22_hypothesis_smoke_wiring_implementation_queue_consumable_manifest", "target": "src_edullm_data_manifest_verify_manifest", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source