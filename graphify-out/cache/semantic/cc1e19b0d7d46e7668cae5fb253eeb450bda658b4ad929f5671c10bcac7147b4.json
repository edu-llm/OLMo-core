{"nodes": [{"id": "github_workflows_edullm_assign_workflow", "label": "Assign eduLLM jobs workflow", "file_type": "document", "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L1-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scans ready Issues, assigns an operator, and notifies Slack on a five-minute cron plus workflow_call; runs only on edu-llm/OLMo-core so forks cannot drive the real rotation."}, {"id": "github_workflows_edullm_assign_concurrency_group", "label": "edullm-assignment concurrency group", "file_type": "rationale", "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L12-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assignment and reminder/reassignment runs share one named group with cancel-in-progress false, serializing every mutation of assignment state so two runs cannot double-assign or race a timeout."}, {"id": "github_workflows_edullm_assign_governance_gate", "label": "Manual governance gate on automation jobs", "file_type": "rationale", "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L22-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each automation job carries an if-condition that a reviewed code change must edit before the job can act, so enabling queue automation is a visible, reviewable diff rather than a settings toggle. Assignment has passed that review and now guards only on repository identity, while reminders and terminal notification remain disabled by a literal false."}, {"id": "github_workflows_edullm_assign_pinned_action_supply_chain", "label": "SHA-pinned actions without persisted credentials", "file_type": "rationale", "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L26-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "checkout and setup-python are pinned to full commit SHAs and checkout runs with persist-credentials false, so a retagged third-party action cannot change behavior and the checkout token is never left in the runner's git config."}], "edges": [{"source": "github_workflows_edullm_assign_workflow", "target": "src_edullm_cli_automation_assign", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L35", "weight": 1.0}, {"source": "github_workflows_edullm_assign_workflow", "target": "src_edullm_assignment_assign_ready_issues", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L34-L35", "weight": 1.0}, {"source": "github_workflows_edullm_assign_workflow", "target": "src_edullm_notifications_slacknotifier_assignment", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L34-L39", "weight": 1.0}, {"source": "github_workflows_edullm_assign_workflow", "target": "github_workflows_edullm_assign_concurrency_group", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L12-L14", "weight": 1.0}, {"source": "github_workflows_edullm_assign_workflow", "target": "github_workflows_edullm_assign_governance_gate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L22-L23", "weight": 1.0}, {"source": "github_workflows_edullm_assign_workflow", "target": "github_workflows_edullm_assign_pinned_action_supply_chain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/edullm-assign.yml", "source_location": "L26-L31", "weight": 1.0}, {"source": "github_workflows_e